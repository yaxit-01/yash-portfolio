# Supabase Configuration for Admin Dashboard
# Use ONLY your Project URL and public 'anon' key.
# Authentication is handled by Supabase Auth with persistent session storage.
# NEVER put your 'service_role' secret key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

